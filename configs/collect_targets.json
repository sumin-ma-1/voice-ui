{
  "description": "Whitelist of window title substrings for automatic dataset collection.",
  "collection": {
    "maximize_window": true,
    "maximize_settle_ms": 400,
    "per_screen_cap": 0
  },
  "auto_discover": {
    "enabled": false,
    "merge_with_static_targets": true,
    "max_apps": 25
  },
  "browser_defaults": {
    "mode_for_browsers": "chrome_only",
    "require_blank_tab_for_browsers": true,
    "chrome_band_ratio": 0.16
  },
  "auto_launch": {
    "enabled": false,
    "launch_wait_ms": 12000,
    "skip_if_window_open": true,
    "presets": {
      "Chrome": {
        "launch": "chrome",
        "launch_args": ["--new-window", "about:blank"]
      },
      "Edge": {
        "launch": "edge",
        "launch_args": ["--new-window", "about:blank"]
      },
      "Visual Studio Code": {
        "launch": "vscode"
      },
      "PowerPoint": {
        "launch": "powerpoint"
      }
    }
  },
  "browser_history": {
    "enabled": false,
    "browsers": ["chrome", "edge"],
    "history_limit": 25,
    "history_days": 14,
    "page_load_ms": 3000,
    "loops_per_page": 1,
    "per_screen_cap": 0,
    "one_per_domain": true,
    "domain_allowlist": [],
    "domain_blocklist": ["accounts.google.com", "login.live.com"],
    "fallback_queries": ["menu", "search", "settings", "share"],
    "randomize_query": true,
    "browser_ui": {
      "mode": "page_only",
      "chrome_band_ratio": 0.16,
      "strict_top_band": true,
      "dedupe_across_pages": true
    }
  },
  "targets": [
    {
      "enabled": true,
      "title_substring": "Chrome",
      "browser_ui": {
        "mode": "chrome_only",
        "require_blank_tab": true
      },
      "fallback_queries": ["back", "refresh", "menu"],
      "randomize_query": true
    },
    {
      "enabled": true,
      "title_substring": "Edge",
      "browser_ui": {
        "mode": "chrome_only",
        "require_blank_tab": true
      },
      "fallback_queries": ["back", "refresh", "menu"],
      "randomize_query": true
    },
    {
      "enabled": true,
      "title_substring": "Visual Studio Code",
      "fallback_queries": ["search", "settings", "extensions"],
      "randomize_query": true
    },
    {
      "enabled": true,
      "title_substring": "PowerPoint",
      "fallback_queries": ["slideshow", "save", "new slide"],
      "randomize_query": true
    }
  ]
}
